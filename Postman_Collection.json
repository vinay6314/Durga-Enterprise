{
  "info": {
    "name": "Mini ERP + CRM Operations Portal API",
    "description": "Complete Postman collection covering Authentication, Customer CRM, Products & Inventory, Stock Audit Logs, Sales Challans, and PDF Invoice Generation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@erp.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/auth/login", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login (Sales)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sales@erp.com\",\n  \"password\": \"Sales@123\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/auth/login", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Get Current User Profile (/auth/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": { "raw": "http://localhost:5000/api/auth/me", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Customer CRM",
      "item": [
        {
          "name": "List Customers (Search & Filter)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": { "raw": "http://localhost:5000/api/customers?status=ACTIVE&search=Apex", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "customers"] }
          }
        },
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Precision Tools Hub\",\n  \"mobile\": \"+91 9123456789\",\n  \"email\": \"info@precisiontools.com\",\n  \"businessName\": \"Precision Tools Ltd\",\n  \"gstNumber\": \"27AAACP99991Z1\",\n  \"customerType\": \"WHOLESALE\",\n  \"address\": \"Industrial Estate Phase 2, Pune 411018\",\n  \"status\": \"LEAD\",\n  \"followUpDate\": \"2026-08-25\",\n  \"notes\": \"Inquired about industrial drill bits.\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/customers", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "customers"] }
          }
        },
        {
          "name": "Add Follow-Up Note",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Discussed payment terms. Customer agreed to 15-day credit cycle.\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/customers/CUSTOMER_ID/followups", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "customers", "CUSTOMER_ID", "followups"] }
          }
        }
      ]
    },
    {
      "name": "Products & Inventory",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": { "raw": "http://localhost:5000/api/products", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "products"] }
          }
        },
        {
          "name": "Record Stock Movement (IN/OUT)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantityChanged\": 15,\n  \"movementType\": \"IN\",\n  \"reason\": \"Warehouse Shipment PO-9082 Receipt\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/products/PRODUCT_ID/stock-movement", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "products", "PRODUCT_ID", "stock-movement"] }
          }
        }
      ]
    },
    {
      "name": "Sales Challans & Invoices",
      "item": [
        {
          "name": "Create Sales Challan (Confirmed or Draft)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"CUSTOMER_ID\",\n  \"status\": \"CONFIRMED\",\n  \"items\": [\n    {\n      \"productId\": \"PRODUCT_ID\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": { "raw": "http://localhost:5000/api/challans", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "challans"] }
          }
        },
        {
          "name": "Download PDF Invoice",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": { "raw": "http://localhost:5000/api/challans/CHALLAN_ID/pdf", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "challans", "CHALLAN_ID", "pdf"] }
          }
        }
      ]
    }
  ]
}
